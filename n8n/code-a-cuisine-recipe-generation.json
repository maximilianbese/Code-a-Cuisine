{
  "name": "Code à Cuisine – Recipe Generation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-recipes",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://code-a-cuisine.maximilian-bese.de,http://localhost:4200"
        }
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -260,
        300
      ],
      "webhookId": "code-a-cuisine-generate"
    },
    {
      "parameters": {
        "jsCode": "// IP-based rate limiting (Kostenairbag): 3 recipes per IP per day, 12 system-wide.\nconst store = $getWorkflowStaticData('global');\nconst today = new Date().toISOString().slice(0, 10);\nif (store.day !== today) { store.day = today; store.perIp = {}; store.total = 0; }\nconst headers = $json.headers || {};\nconst forwarded = headers['x-forwarded-for'] || headers['x-real-ip'] || 'unknown';\nconst ip = String(forwarded).split(',')[0].trim();\nconst IP_LIMIT = 3;\nconst SYSTEM_LIMIT = 12;\nconst usedByIp = store.perIp[ip] || 0;\nconst exceeded = usedByIp >= IP_LIMIT || (store.total || 0) >= SYSTEM_LIMIT;\nif (!exceeded) { store.perIp[ip] = usedByIp + 1; store.total = (store.total || 0) + 1; }\nconst remaining = Math.max(0, IP_LIMIT - (store.perIp[ip] || usedByIp));\nreturn [{ json: { ...$json, ip, exceeded, remaining } }];"
      },
      "id": "ratelimit-1",
      "name": "Rate Limit (IP)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-quota",
              "leftValue": "={{ $json.exceeded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-quota-1",
      "name": "Quota Exceeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 429,
        "responseBody": "={{ { error: 'Daily recipe limit reached. Please try again tomorrow.', remaining: 0 } }}",
        "options": {}
      },
      "id": "respond-429",
      "name": "Respond Quota Exceeded",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        400,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst ingredients = Array.isArray(body.ingredients) ? body.ingredients : [];\nconst prefs = body.preferences ?? {};\nif (ingredients.length === 0) { throw new Error('No ingredients provided'); }\nif (!prefs.portions || prefs.portions < 1) { throw new Error('Invalid portions'); }\nconst list = ingredients.map(i => `${i.amount}${i.unit === 'piece' ? ' pc' : i.unit} ${i.name}`).join(', ');\nconst prompt = [\n  'You are a recipe generator. Return ONLY a valid JSON array of exactly 3 recipe objects. No markdown, no commentary.',\n  'Each object must have: id (kebab-case string), index (1-3), title, cookingTimeMin (number), cuisine, timeLabel, diet, likes (number 0-100), cooks (number), portions (number), nutrition {calories,protein,fat,carbs} (all numbers, per portion), yourIngredients [{amount,name}], extraIngredients [{amount,name}], steps [{order,title,chef,text}].',\n  `Available ingredients: ${list}.`,\n  `Preferences: portions=${prefs.portions}, cooks=${prefs.cooks}, time=${prefs.time}, cuisine=${prefs.cuisine}, diet=${prefs.diet}.`,\n  `Set portions=${prefs.portions} on every recipe and give nutrition per single portion.`,\n  `Distribute the steps across ${prefs.cooks} chef(s) using the chef field (values 1..${prefs.cooks}).`\n].join('\\n');\nreturn [{ json: { prompt } }];"
      },
      "id": "code-validate-1",
      "name": "Validate & Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "options": {}
      },
      "id": "http-gemini-1",
      "name": "Generate with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const res = $json;\nconst text = res?.candidates?.[0]?.content?.parts?.[0]?.text ?? '[]';\nlet data;\ntry { data = JSON.parse(text); } catch (e) { throw new Error('Model did not return valid JSON'); }\nconst recipes = Array.isArray(data) ? data : (data.recipes ?? []);\nconst normalized = recipes.slice(0, 3).map((r, i) => ({ ...r, index: r.index ?? i + 1 }));\nreturn [{ json: { recipes: normalized } }];"
      },
      "id": "code-parse-1",
      "name": "Parse Recipes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        380
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.recipes }}",
        "options": {}
      },
      "id": "respond-1",
      "name": "Respond to App",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1060,
        280
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "recipes",
        "options": {}
      },
      "id": "split-1",
      "name": "Split Recipes",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1060,
        480
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "projectId": "YOUR_FIREBASE_PROJECT_ID",
        "database": "(default)",
        "collection": "recipes",
        "documentId": "={{ $json.id }}",
        "columns": "id,index,title,cookingTimeMin,cuisine,timeLabel,diet,likes,cooks,portions,nutrition,yourIngredients,extraIngredients,steps"
      },
      "id": "firestore-1",
      "name": "Save to Firestore",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [
        1280,
        480
      ],
      "disabled": true,
      "notes": "Aktivieren, sobald die Firestore-Credentials (Google Service Account) hinterlegt sind. Projekt-ID oben eintragen."
    },
    {
      "parameters": {},
      "id": "error-trigger-1",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -40,
        620
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@code-a-cuisine.example",
        "toEmail": "you@example.com",
        "subject": "=Code à Cuisine – Workflow-Fehler: {{ $json.workflow?.name }}",
        "emailFormat": "text",
        "text": "={{ 'Der Workflow ist fehlgeschlagen.\\n\\nWorkflow: ' + ($json.workflow?.name || 'n/a') + '\\nFehler-Node: ' + ($json.execution?.lastNodeExecuted || 'n/a') + '\\nMeldung: ' + ($json.execution?.error?.message || 'n/a') + '\\nZeit: ' + $now }}",
        "options": {}
      },
      "id": "email-1",
      "name": "Send Error Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        180,
        620
      ],
      "notes": "SMTP-Credential zuweisen und echten Empfaenger (toEmail) eintragen."
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "library",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://code-a-cuisine.maximilian-bese.de,http://localhost:4200"
        }
      },
      "id": "webhook-library",
      "name": "Webhook Library",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -260,
        720
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "projectId": "YOUR_FIREBASE_PROJECT_ID",
        "database": "(default)",
        "collection": "recipes",
        "returnAll": true,
        "options": {}
      },
      "id": "firestore-library",
      "name": "Read Firestore Library",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [
        -20,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "const clean = (o) => Object.fromEntries(Object.entries(o).filter(([k]) => !k.startsWith('_')));\nconst recipes = $input.all().map((i) => clean(i.json));\nreturn [{ json: { recipes } }];"
      },
      "id": "code-aggregate-library",
      "name": "Aggregate Library",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        720
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.recipes }}",
        "options": {}
      },
      "id": "respond-library",
      "name": "Respond Library",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        720
      ]
    }
  ],
