# Kopiere diese Datei nach n8n/.env und trage deine öffentliche Adresse ein.
# Der abschließende Slash gehört dazu – n8n hängt die Pfade direkt an.
#
# Beispiel mit Tailscale Funnel:
#   N8N_PUBLIC_URL=https://mein-rechner.tailXXXX.ts.net/
#
# Solange die Zeile auskommentiert bleibt, läuft n8n rein lokal.
#N8N_PUBLIC_URL=
