# SPA-Routing für netcup-Webhosting (Apache)
# Leitet alle Anfragen, die keine echte Datei/Ordner sind, auf index.html
# damit Deep-Links wie /recipe/5 beim Neuladen funktionieren.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Kompression für schnellere Ladezeiten
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
